{% extends 'base.html.twig' %}

{% block title %}Gestion des carrières — GERM{% endblock %}
{% block page_title %}Gestion des carrières{% endblock %}

{% block body %}
<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Service</label>
        <select name="service" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Tous les services</option>
            {% for s in services %}
                <option value="{{ s.id }}" {{ filtre_service and filtre_service.id == s.id ? 'selected' }}>{{ s.nom }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Type de mouvement</label>
        <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Tous les types</option>
            {% for t in types %}
                <option value="{{ t.value }}" {{ filtre_type and filtre_type == t ? 'selected' }}>{{ t.label }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Du</label>
        <input type="date" name="date_debut" value="{{ date_debut }}" class="form-control form-control-sm" onchange="this.form.submit()">
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Au</label>
        <input type="date" name="date_fin" value="{{ date_fin }}" class="form-control form-control-sm" onchange="this.form.submit()">
    </div>
    {% if filtre_service or filtre_type or date_debut or date_fin %}
        <div class="col-md-2">
            <a href="{{ path('admin_carriere_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        </div>
    {% endif %}
</form>

<div class="card stat-card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
        <tr>
            <th>Date d'effet</th>
            <th>Agent</th>
            <th>Type</th>
            <th>Service</th>
            <th>Fonction</th>
            <th>N° décision</th>
        </tr>
        </thead>
        <tbody>
        {% for mouvement in mouvements %}
            <tr>
                <td>{{ mouvement.dateEffet|date('d/m/Y') }}</td>
                <td><a href="{{ path('admin_personnel_show', {id: mouvement.personnel.id}) }}">{{ mouvement.personnel.nomComplet }}</a></td>
                <td>{{ mouvement.typeMouvement.label }}</td>
                <td>{{ mouvement.service }}</td>
                <td>{{ mouvement.fonction }}</td>
                <td>{{ mouvement.numeroDecision|default('-') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun mouvement enregistré.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
