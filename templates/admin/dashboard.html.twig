{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — GERM{% endblock %}
{% block page_title %}Tableau de bord superadmin{% endblock %}

{% block body %}
<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Filtrer par direction</label>
        <select name="direction" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Toutes les directions</option>
            {% for d in directions %}
                <option value="{{ d.id }}" {{ filtre_direction and filtre_direction.id == d.id ? 'selected' }}>{{ d.nom }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Filtrer par service</label>
        <select name="service" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Tous les services</option>
            {% for s in services %}
                <option value="{{ s.id }}" {{ filtre_service and filtre_service.id == s.id ? 'selected' }}>{{ s.nom }}</option>
            {% endfor %}
        </select>
    </div>
    {% if filtre_direction or filtre_service %}
        <div class="col-md-2">
            <a href="{{ path('admin_dashboard') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        </div>
    {% endif %}
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Personnel</div>
            <div class="fs-3 fw-bold">{{ nb_personnel }}</div>
            <a href="{{ path('admin_personnel_index') }}" class="small">Voir la liste →</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Parc informatique</div>
            <div class="fs-3 fw-bold">{{ nb_materiels }}</div>
            <a href="{{ path('admin_materiel_index') }}" class="small">Voir la liste →</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Parc automobile</div>
            <div class="fs-3 fw-bold">{{ nb_vehicules }}</div>
            <a href="{{ path('admin_vehicule_index') }}" class="small">Voir la liste →</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Services / Directions</div>
            <div class="fs-3 fw-bold">{{ nb_services }}</div>
            <a href="{{ path('admin_service_index') }}" class="small">Voir la liste →</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card stat-card p-3">
            <h6 class="mb-3"><i class="bi bi-exclamation-triangle text-warning"></i> Garanties matériel expirant sous 30 jours</h6>
            {% if garanties_expirant is empty %}
                <p class="text-muted small mb-0">Aucune échéance proche.</p>
            {% else %}
                <table class="table table-sm mb-0">
                    <thead><tr><th>Matériel</th><th>N° inventaire</th><th>Garantie jusqu'au</th></tr></thead>
                    <tbody>
                    {% for m in garanties_expirant %}
                        <tr>
                            <td><a href="{{ path('admin_materiel_show', {id: m.id}) }}">{{ m.marque }} {{ m.modele }}</a></td>
                            <td>{{ m.numeroInventaire }}</td>
                            <td>{{ m.garantieJusquau ? m.garantieJusquau|date('d/m/Y') : '-' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card p-3">
            <h6 class="mb-3"><i class="bi bi-exclamation-triangle text-warning"></i> Échéances véhicules (assurance / visite technique)</h6>
            {% if echeances_vehicules is empty %}
                <p class="text-muted small mb-0">Aucune échéance proche.</p>
            {% else %}
                <table class="table table-sm mb-0">
                    <thead><tr><th>Véhicule</th><th>Immatriculation</th><th>Assurance</th><th>Visite technique</th></tr></thead>
                    <tbody>
                    {% for v in echeances_vehicules %}
                        <tr>
                            <td><a href="{{ path('admin_vehicule_show', {id: v.id}) }}">{{ v.marque }} {{ v.modele }}</a></td>
                            <td>{{ v.immatriculation }}</td>
                            <td>{{ v.assuranceJusquau ? v.assuranceJusquau|date('d/m/Y') : '-' }}</td>
                            <td>{{ v.visiteTechniqueJusquau ? v.visiteTechniqueJusquau|date('d/m/Y') : '-' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <div class="card stat-card p-3">
            <h6 class="mb-3"><i class="bi bi-bar-chart"></i> Répartition par sexe et par direction</h6>
            {% if repartition_par_direction is empty %}
                <p class="text-muted small mb-0">Aucune donnée pour ce filtre.</p>
            {% else %}
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Direction</th><th>Hommes</th><th>Femmes</th><th>Total</th><th style="width:30%">Répartition</th></tr></thead>
                    <tbody>
                    {% for nom, counts in repartition_par_direction %}
                        {% set total = counts.M + counts.F %}
                        <tr>
                            <td>{{ nom }}</td>
                            <td>{{ counts.M }}</td>
                            <td>{{ counts.F }}</td>
                            <td>{{ total }}</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" style="width: {{ total ? (counts.M / total * 100) : 0 }}%"></div>
                                    <div class="progress-bar bg-danger" style="width: {{ total ? (counts.F / total * 100) : 0 }}%"></div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card p-3">
            <h6 class="mb-3"><i class="bi bi-bar-chart"></i> Répartition par sexe et par service</h6>
            {% if repartition_par_service is empty %}
                <p class="text-muted small mb-0">Aucune donnée pour ce filtre.</p>
            {% else %}
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Service</th><th>Hommes</th><th>Femmes</th><th>Total</th><th style="width:30%">Répartition</th></tr></thead>
                    <tbody>
                    {% for nom, counts in repartition_par_service %}
                        {% set total = counts.M + counts.F %}
                        <tr>
                            <td>{{ nom }}</td>
                            <td>{{ counts.M }}</td>
                            <td>{{ counts.F }}</td>
                            <td>{{ total }}</td>
                            <td>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" style="width: {{ total ? (counts.M / total * 100) : 0 }}%"></div>
                                    <div class="progress-bar bg-danger" style="width: {{ total ? (counts.F / total * 100) : 0 }}%"></div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
