{% extends 'base.html.twig' %}

{% block title %}{{ materiel.numeroInventaire }} — GERM{% endblock %}
{% block page_title %}Fiche matériel{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">{{ materiel.marque }} {{ materiel.modele }} — {{ materiel.numeroInventaire }}</h5>
    <div>
        <a href="{{ path('admin_materiel_edit', {id: materiel.id}) }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Modifier</a>
        <a href="{{ path('admin_materiel_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
    </div>
</div>

<div class="card stat-card p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Type</dt><dd class="col-sm-9">{{ materiel.type ? materiel.type.libelle : '-' }}</dd>
        <dt class="col-sm-3">Numéro de série</dt><dd class="col-sm-9">{{ materiel.numeroSerie|default('-') }}</dd>
        <dt class="col-sm-3">Service / Direction</dt><dd class="col-sm-9">{{ materiel.service }}</dd>
        <dt class="col-sm-3">Affecté à</dt><dd class="col-sm-9">{{ materiel.affecteA ? materiel.affecteA.nomComplet : 'Non affecté' }}</dd>
        <dt class="col-sm-3">Fournisseur</dt><dd class="col-sm-9">{{ materiel.fournisseur|default('-') }}</dd>
        <dt class="col-sm-3">Date d'acquisition</dt><dd class="col-sm-9">{{ materiel.dateAcquisition ? materiel.dateAcquisition|date('d/m/Y') : '-' }}</dd>
        <dt class="col-sm-3">Garantie jusqu'au</dt><dd class="col-sm-9">{{ materiel.garantieJusquau ? materiel.garantieJusquau|date('d/m/Y') : '-' }}</dd>
        <dt class="col-sm-3">État</dt><dd class="col-sm-9">{{ materiel.etat.libelle }}</dd>
        <dt class="col-sm-3">Caractéristiques</dt><dd class="col-sm-9">{{ materiel.specifications|default('-')|nl2br }}</dd>
        <dt class="col-sm-3">Observations</dt><dd class="col-sm-9">{{ materiel.observations|default('-')|nl2br }}</dd>
    </dl>
</div>
{% endblock %}
