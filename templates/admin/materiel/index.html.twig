{% extends 'base.html.twig' %}

{% block title %}Parc informatique — GERM{% endblock %}
{% block page_title %}Parc informatique{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex" method="get">
        <input type="search" name="q" value="{{ q }}" class="form-control me-2" placeholder="Rechercher (n° inventaire, marque, modèle...)">
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <a href="{{ path('admin_materiel_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau matériel</a>
</div>

<div class="card stat-card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
        <tr>
            <th>N° inventaire</th>
            <th>Type</th>
            <th>Marque / Modèle</th>
            <th>Service</th>
            <th>Affecté à</th>
            <th>État</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for materiel in materiels %}
            <tr>
                <td>{{ materiel.numeroInventaire }}</td>
                <td>{{ materiel.type ? materiel.type.libelle : '-' }}</td>
                <td>{{ materiel.marque }} {{ materiel.modele }}</td>
                <td>{{ materiel.service }}</td>
                <td>{{ materiel.affecteA ? materiel.affecteA.nomComplet : '—' }}</td>
                <td><span class="badge text-bg-{{ materiel.etat.code == 'en_service' ? 'success' : (materiel.etat.code == 'en_panne' ? 'danger' : 'secondary') }}">{{ materiel.etat.libelle }}</span></td>
                <td class="text-end">
                    <a href="{{ path('admin_materiel_show', {id: materiel.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                    <a href="{{ path('admin_materiel_edit', {id: materiel.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form method="post" action="{{ path('admin_materiel_delete', {id: materiel.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce matériel ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-materiel-' ~ materiel.id) }}">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Aucun matériel enregistré.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
