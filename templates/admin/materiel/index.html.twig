{% extends 'base.html.twig' %}

{% block title %}Parc informatique — GERM{% endblock %}
{% block page_title %}Parc informatique{% endblock %}

{# État du matériel : icône + couleur sémantique — miroir de
   ICONES_ETAT_MATERIEL/COULEURS_ETAT_MATERIEL côté Angular, voir
   frontend/src/app/shared/materiel/materiel-indicateurs.util.ts. #}
{% macro etat_icon(etat) %}
    {% set icones = {en_service: 'check-circle-fill', en_stock: 'box-seam', en_panne: 'exclamation-triangle-fill', en_maintenance: 'tools', reforme: 'slash-circle'} %}
    {% set couleurs = {en_service: 'success', en_stock: 'info', en_panne: 'danger', en_maintenance: 'warning-emphasis', reforme: 'secondary'} %}
    <span class="text-{{ couleurs[etat.code] ?? 'secondary' }}">
        <i class="bi bi-{{ icones[etat.code] ?? 'question-circle-fill' }}"></i> {{ etat.libelle }}
    </span>
{% endmacro %}

{# Icônes "antivirus installé" + statut d'expiration — mêmes seuils d'alerte
   (90j / 30j) que badgesAntivirus() côté Angular. #}
{% macro antivirus_icons(antivirus) %}
    {% if antivirus is null %}
        <i class="bi bi-shield-slash text-secondary" title="Aucun antivirus installé"></i>
    {% else %}
        <i class="bi bi-shield-check text-success" title="Antivirus installé : {{ antivirus.logiciel.libelle }}"></i>
        {% if antivirus.dateExpiration is not null %}
            {% set jours = ((antivirus.dateExpiration|date('U')) - ("now"|date('U'))) // 86400 %}
            {% set date_fr = antivirus.dateExpiration|date('d/m/Y') %}
            {% if jours < 0 %}
                <i class="bi bi-shield-fill-x text-danger" title="Antivirus expiré depuis le {{ date_fr }}"></i>
            {% elseif jours <= 30 %}
                <i class="bi bi-shield-fill-exclamation text-danger" title="Antivirus expire le {{ date_fr }} (dans {{ jours }} j)"></i>
            {% elseif jours <= 90 %}
                <i class="bi bi-shield-fill-exclamation text-warning-emphasis" title="Antivirus expire le {{ date_fr }} (dans {{ jours }} j)"></i>
            {% else %}
                <i class="bi bi-shield-fill-check text-success" title="Antivirus valide jusqu'au {{ date_fr }}"></i>
            {% endif %}
        {% endif %}
    {% endif %}
{% endmacro %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex" method="get">
        <input type="search" name="q" value="{{ q }}" class="form-control me-2" placeholder="Rechercher (n° inventaire, marque, modèle...)">
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_import_upload', {type: 'materiel'}) }}" class="btn btn-outline-secondary"><i class="bi bi-upload"></i> Importer</a>
        <a href="{{ path('admin_materiel_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau matériel</a>
    </div>
</div>

<div class="card stat-card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
        <tr>
            <th>N° inventaire</th>
            <th>Type</th>
            <th>Marque / Modèle</th>
            <th>Service</th>
            <th>Affecté à</th>
            <th>État</th>
            <th>Antivirus</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for materiel in materiels %}
            <tr>
                <td>{{ materiel.numeroInventaire }}</td>
                <td>{{ materiel.type ? materiel.type.libelle : '-' }}</td>
                <td>{{ materiel.marque }} {{ materiel.modele }}</td>
                <td>{{ materiel.service ?? '-' }}</td>
                <td>{{ materiel.affecteA ? materiel.affecteA.nomComplet : '—' }}</td>
                <td>{{ _self.etat_icon(materiel.etat) }}</td>
                <td>{{ _self.antivirus_icons(materiel.antivirus) }}</td>
                <td class="text-end">
                    <a href="{{ path('admin_materiel_show', {id: materiel.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                    <a href="{{ path('admin_materiel_edit', {id: materiel.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form method="post" action="{{ path('admin_materiel_delete', {id: materiel.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce matériel ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-materiel-' ~ materiel.id) }}">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="text-center text-muted py-4">Aucun matériel enregistré.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
