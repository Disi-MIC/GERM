{% extends 'base.html.twig' %}

{% block title %}Listes de valeurs — GERM{% endblock %}
{% block page_title %}Listes de valeurs paramétrables{% endblock %}

{% block body %}
<div class="row g-3">
    {% for categorie in categories %}
        <div class="col-md-4">
            <a href="{{ path('admin_liste_valeur_index', {categorie: categorie.value}) }}" class="text-decoration-none">
                <div class="card stat-card p-3 h-100">
                    <div class="fw-semibold text-dark"><i class="bi bi-list-check"></i> {{ categorie.label }}</div>
                    <div class="text-muted small mt-1">Gérer les valeurs de cette liste</div>
                </div>
            </a>
        </div>
    {% endfor %}
</div>
{% endblock %}
