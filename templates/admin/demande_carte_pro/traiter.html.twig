{% extends 'base.html.twig' %}

{% block title %}Traiter la demande — {{ demande.personnel.nomComplet }} — GERM{% endblock %}
{% block page_title %}Traiter la demande de carte professionnelle{% endblock %}

{% block body %}
<div class="card stat-card p-4" style="max-width: 600px;">
    <dl class="row mb-3">
        <dt class="col-sm-4">Agent</dt><dd class="col-sm-8">{{ demande.personnel.nomComplet }}</dd>
        <dt class="col-sm-4">Type</dt><dd class="col-sm-8">{{ demande.typeDemande.label }}</dd>
        <dt class="col-sm-4">Carte concernée</dt>
        <dd class="col-sm-8">{{ demande.carteReference ? demande.carteReference.numero ~ ' (expire le ' ~ demande.carteReference.dateExpiration|date('d/m/Y') ~ ')' : '-' }}</dd>
        <dt class="col-sm-4">Motif</dt><dd class="col-sm-8">{{ demande.motif|default('-') }}</dd>
        <dt class="col-sm-4">Pièce justificative</dt>
        <dd class="col-sm-8">
            {% if demande.cheminFichier %}
                <a href="{{ path('admin_piece_carte_pro_download', {id: demande.id}) }}" class="d-block"><i class="bi bi-paperclip"></i> {{ demande.nomOriginal }}</a>
            {% else %}
                -
            {% endif %}
        </dd>
    </dl>

    {% if demande.enAttente %}
        <div class="alert alert-info small">
            Vérifiez la conformité de la pièce jointe, puis transmettez la demande au RH Admin (qui seul peut l'approuver), ou rejetez-la si les pièces ne sont pas conformes.
        </div>

        <div class="mb-3">
            <label for="commentaire" class="form-label">Motif du rejet (si vous rejetez)</label>
            <textarea name="commentaire" id="commentaire" form="form-rejeter" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <form method="post" action="{{ path('admin_demande_carte_pro_transmettre', {id: demande.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('traiter-demande-carte-pro-' ~ demande.id) }}">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Transmettre au RH Admin</button>
            </form>
            <form id="form-rejeter" method="post" action="{{ path('admin_demande_carte_pro_rejeter', {id: demande.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('traiter-demande-carte-pro-' ~ demande.id) }}">
                <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg"></i> Rejeter</button>
            </form>
            <a href="{{ path('admin_demande_carte_pro_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    {% elseif demande.transmise %}
        <div class="alert alert-warning small">
            Demande transmise par le RH Carte Pro, en attente de votre décision (RH Admin).
        </div>

        <form method="post" action="{{ path('admin_demande_carte_pro_approuver', {id: demande.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('traiter-demande-carte-pro-' ~ demande.id) }}">

            <div class="border rounded p-3 mb-3">
                <div class="mb-2">
                    <label for="numero" class="form-label">Numéro de carte</label>
                    <input type="text" name="numero" id="numero" class="form-control">
                </div>
                <div class="mb-0">
                    <label for="date_delivrance" class="form-label">Date de délivrance</label>
                    <input type="date" name="date_delivrance" id="date_delivrance" class="form-control">
                    <div class="form-text">La date d'expiration sera calculée automatiquement (+5 ans). La carte sera immédiatement validée (cachet/signature) et téléchargeable.</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="commentaire2" class="form-label">Commentaire (optionnel)</label>
                <textarea name="commentaire" id="commentaire2" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Approuver</button>
                <button type="submit" formaction="{{ path('admin_demande_carte_pro_rejeter', {id: demande.id}) }}" class="btn btn-danger"><i class="bi bi-x-lg"></i> Rejeter</button>
                <a href="{{ path('admin_demande_carte_pro_index') }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
