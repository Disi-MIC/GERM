{% extends 'base.html.twig' %}

{% block title %}Import — {{ type.label }} — GERM{% endblock %}
{% block page_title %}Import — {{ type.label }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="{{ path(type.indexRoute) }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    <a href="{{ path('admin_import_template', {type: type.value}) }}" class="btn btn-outline-primary"><i class="bi bi-file-earmark-excel"></i> Télécharger le modèle Excel</a>
</div>

<div class="card stat-card p-3 mb-4">
    <h6 class="mb-3">Colonnes attendues</h6>
    <table class="table table-sm mb-0">
        <thead><tr><th>Colonne</th><th>Description</th><th>Obligatoire</th></tr></thead>
        <tbody>
        {% for column in columns %}
            <tr>
                <td><code>{{ column.key }}</code></td>
                <td>{{ column.label }}</td>
                <td>{{ column.required ? 'Oui' : 'Non' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card stat-card p-3 h-100">
            <h6 class="mb-3">Importer un fichier</h6>
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('import-' ~ type.value) }}">
                <input type="file" name="file" accept=".csv,.xlsx" class="form-control mb-3" required>
                <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Importer</button>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card stat-card p-3 h-100">
            <h6 class="mb-3"><i class="bi bi-google text-muted"></i> Lier à un Google Sheet</h6>
            {% if lien %}
                <p class="small text-muted mb-2">
                    Classeur lié :
                    <a href="{{ lien.url }}" target="_blank" rel="noopener" class="text-truncate d-inline-block align-bottom" style="max-width: 260px;">{{ lien.url }}</a>
                </p>
                <p class="small text-muted mb-3">
                    {% if lien.derniereSynchronisationAt %}
                        Dernière synchronisation : {{ lien.derniereSynchronisationAt|date('d/m/Y H:i') }}
                    {% else %}
                        Jamais synchronisé.
                    {% endif %}
                </p>
                <form method="post" action="{{ path('admin_import_google_sheet_synchroniser', {type: type.value}) }}" class="mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('import-google-sheet-sync-' ~ type.value) }}">
                    <button type="submit" class="btn btn-success"><i class="bi bi-arrow-repeat"></i> Synchroniser maintenant</button>
                </form>
                <hr>
                <p class="small text-muted mb-2">Remplacer le lien :</p>
            {% else %}
                <p class="small text-muted mb-3">
                    Partagez le classeur avec l'accès <strong>"Toute personne disposant du lien — Lecteur"</strong>,
                    puis collez son lien de partage ci-dessous. La première ligne du classeur doit contenir les
                    mêmes colonnes que le modèle Excel (voir tableau ci-dessus).
                </p>
            {% endif %}
            <form method="post" action="{{ path('admin_import_google_sheet_lier', {type: type.value}) }}" class="d-flex gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('import-google-sheet-' ~ type.value) }}">
                <input type="url" name="url" placeholder="https://docs.google.com/spreadsheets/d/..." class="form-control" required>
                <button type="submit" class="btn btn-outline-primary text-nowrap"><i class="bi bi-link-45deg"></i> Lier</button>
            </form>
        </div>
    </div>
</div>

{% if report %}
    <div class="card stat-card p-3">
        <h6 class="mb-3">Résultat de l'import</h6>

        {% if report.globalError %}
            <div class="alert alert-danger">{{ report.globalError }}</div>
        {% else %}
            <div class="d-flex gap-2 mb-3">
                <span class="badge text-bg-success">{{ report.created }} créé(s)</span>
                <span class="badge text-bg-secondary">{{ report.skippedExisting }} ignoré(s) (déjà existant)</span>
                <span class="badge text-bg-danger">{{ report.errors }} en erreur</span>
            </div>

            {% if report.rowResults is not empty %}
                <table class="table table-sm mb-0">
                    <thead><tr><th>Ligne</th><th>Statut</th><th>Message</th></tr></thead>
                    <tbody>
                    {% for row in report.rowResults %}
                        <tr>
                            <td>{{ row.lineNumber }}</td>
                            <td>
                                {% if row.status.name == 'SKIPPED_EXISTING' %}
                                    <span class="badge text-bg-secondary">Ignoré</span>
                                {% else %}
                                    <span class="badge text-bg-danger">Erreur</span>
                                {% endif %}
                            </td>
                            <td>{{ row.message }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endif %}
    </div>
{% endif %}
{% endblock %}
