{% extends 'base.html.twig' %}

{% block title %}Cartes professionnelles — GERM{% endblock %}
{% block page_title %}Cartes professionnelles{% endblock %}

{% block body %}
<div class="row g-3 mb-4">
    {% for label, badge in {'Valide': 'success', 'Expire bientôt': 'warning', 'Expirée': 'secondary', 'Perdue': 'danger', 'Volée': 'danger', 'Annulée': 'secondary'} %}
        <div class="col-6 col-md-2">
            <a href="{{ path('admin_carte_professionnelle_index', filtre_statut_affiche == label ? {} : {statut_affiche: label}) }}" class="text-decoration-none">
                <div class="card stat-card p-3 text-center {{ filtre_statut_affiche == label ? 'border border-' ~ badge : '' }}">
                    <div class="fs-4 fw-bold text-{{ badge }}">{{ compteurs[label] }}</div>
                    <div class="small text-muted">{{ label }}</div>
                </div>
            </a>
        </div>
    {% endfor %}
</div>

{% if is_granted('ROLE_RH_RESPONSABLE') and en_attente_validation > 0 %}
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span><i class="bi bi-exclamation-triangle"></i> {{ en_attente_validation }} carte{{ en_attente_validation > 1 ? 's' }} en attente de votre validation.</span>
        <a href="{{ path('admin_carte_professionnelle_validation') }}" class="btn btn-sm btn-warning">Voir</a>
    </div>
{% endif %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        {% if filtre_statut_affiche %}
            <span class="text-muted small">Filtré sur « {{ filtre_statut_affiche }} »</span>
            <a href="{{ path('admin_carte_professionnelle_index') }}" class="small ms-2">Réinitialiser</a>
        {% endif %}
    </div>
    <a href="{{ path('admin_carte_professionnelle_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle carte</a>
</div>

<div class="card stat-card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
        <tr>
            <th>Agent</th>
            <th>Numéro</th>
            <th>Date de délivrance</th>
            <th>Date d'expiration</th>
            <th>Statut</th>
            <th>Validation RH Admin</th>
        </tr>
        </thead>
        <tbody>
        {% for carte in cartes %}
            <tr>
                <td><a href="{{ path('admin_personnel_show', {id: carte.personnel.id}) }}">{{ carte.personnel.nomComplet }}</a></td>
                <td>{{ carte.numero }}</td>
                <td>{{ carte.dateDelivrance|date('d/m/Y') }}</td>
                <td>{{ carte.dateExpiration|date('d/m/Y') }}</td>
                <td>
                    <span class="badge text-bg-{{ carte.statutAffiche.badgeClass }}">{{ carte.statutAffiche.label }}</span>
                </td>
                <td>
                    {% if carte.valideeParAdminRh %}
                        <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> Validée</span>
                    {% else %}
                        <span class="badge text-bg-warning">En attente</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucune carte enregistrée.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
