{{ form_start(form) }}
{% if form.personnel is defined %}{{ form_row(form.personnel) }}{% endif %}
{{ form_row(form.numero) }}
{{ form_row(form.dateDelivrance) }}
<div class="form-text mb-3">La date d'expiration est calculée automatiquement (+5 ans).</div>
{{ form_row(form.statut) }}
{{ form_row(form.observations) }}
{% if carte is defined and carte.id %}
    <div class="mb-3 border rounded p-2 d-flex justify-content-between align-items-center">
        {% if carte.cheminFichier %}
            <a href="{{ path('admin_piece_carte_download', {id: carte.id}) }}"><i class="bi bi-file-earmark-pdf"></i> {{ carte.nomOriginal ?? 'carte-professionnelle.pdf' }}</a>
        {% else %}
            <span class="text-muted small">Aucun PDF généré.</span>
        {% endif %}
        <form method="post" action="{{ path('admin_carte_professionnelle_generer', {id: carte.id}) }}" class="m-0">
            <input type="hidden" name="_token" value="{{ csrf_token('generer-carte-professionnelle-' ~ carte.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-repeat"></i> Régénérer le PDF</button>
        </form>
    </div>
{% endif %}
<div class="mt-3 d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Enregistrer</button>
    <a href="{{ cancel_path }}" class="btn btn-outline-secondary">Annuler</a>
</div>
{{ form_end(form) }}
