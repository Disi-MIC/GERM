{% extends 'base.html.twig' %}

{% block title %}Directions — GERM{% endblock %}
{% block page_title %}Directions du Ministère{% endblock %}

{% block body %}
<div class="d-flex justify-content-end gap-2 mb-3">
    <a href="{{ path('admin_import_upload', {type: 'direction'}) }}" class="btn btn-outline-secondary"><i class="bi bi-upload"></i> Importer</a>
    <a href="{{ path('admin_direction_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle direction</a>
</div>

<div class="card stat-card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
        <tr>
            <th>Code</th>
            <th>Nom</th>
            <th>Description</th>
            <th>Statut</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for direction in directions %}
            <tr>
                <td>{{ direction.code }}</td>
                <td>{{ direction.nom }}</td>
                <td>{{ direction.description|default('-') }}</td>
                <td><span class="badge text-bg-{{ direction.actif ? 'success' : 'secondary' }}">{{ direction.actif ? 'Actif' : 'Inactif' }}</span></td>
                <td class="text-end">
                    <a href="{{ path('admin_direction_edit', {id: direction.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form method="post" action="{{ path('admin_direction_delete', {id: direction.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette direction ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-direction-' ~ direction.id) }}">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-muted py-4">Aucune direction enregistrée.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
