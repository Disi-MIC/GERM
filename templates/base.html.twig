<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GERM — Ministère{% endblock %}</title>
    {# Bootstrap recompilé depuis sa source (public/css/admin-theme.scss) avec les
       mêmes variables Sass que le SPA Angular (voir frontend/src/styles.scss),
       plutôt que le bootstrap.min.css précompilé du CDN : sans ça, seuls les
       styles écrits à la main ci-dessous (sidebar/topbar/stat-card) reprenaient
       la palette Gentelella — .btn-primary, badges, focus de champ, pagination...
       restaient au bleu Bootstrap par défaut. Fichier committé (pas d'étape de
       build au déploiement) ; régénérer après toute modification de la palette
       en suivant la commande en tête de admin-theme.scss. #}
    <link href="{{ asset('css/admin-theme.css') }}" rel="stylesheet">
    {# integrity/crossorigin sur chaque ressource CDN épinglée à une version exacte :
       une compromission de jsdelivr ne peut pas substituer un fichier différent sans
       faire échouer son chargement (hachage vérifié par le navigateur lui-même). #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet" integrity="sha384-Bk5cbLkZQ5raZ0+H2/+VbfYx3WpvxvQK4zqXZr7sYODuaX7bKXoSOnipQxkaS8sv" crossorigin="anonymous">
    {# Polices via le CDN de @fontsource/inter (npm) plutôt que fonts.googleapis.com :
       tout reste sous cdn.jsdelivr.net, déjà seul hôte externe autorisé par la CSP de
       SecurityHeadersListener — ajouter fonts.googleapis.com/fonts.gstatic.com aurait
       exigé d'élargir cette CSP, une décision de sécurité à part entière. #}
    <link href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5/400.css" rel="stylesheet" integrity="sha384-xIqhvN2Z/Umq7Ox8y6t3uFHhjyQo0knjgs1wcj13JjTuHOGIaXBHO7eal9RhNMdd" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5/500.css" rel="stylesheet" integrity="sha384-V0O4X1tN0UwvdYzAEJQFmI91MWdJS28KYainePiRQIAtDyKH5cZxjVuoOPp/0v9g" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5/600.css" rel="stylesheet" integrity="sha384-zZdQWz6lweHJ9ZIJxqSYDpVJzhjcCKCxfftjlgIC/g3Ok/FynI4BfyMWG5/0mJt9" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5/700.css" rel="stylesheet" integrity="sha384-ABwFxKIeYuLxwfO9KnWKaJWmYGG07Ug5PUbvSA8+tyO6Mu3ceWIGYbq+DW5ktdGH" crossorigin="anonymous">
    {# Palette et rayon alignés sur le thème Gentelella du SPA Angular (voir
       frontend/src/styles.scss et shell.component.scss) : même navy de sidebar
       (#1a2332), même accent sarcelle (#1abb9c) avec la barre d'accent posée en
       inset box-shadow plutôt qu'un simple fond plein, même police. Les deux
       interfaces (SPA agent et back-office superadmin) partagent désormais un
       seul système de tokens visuels, même si l'admin les porte en CSS Bootstrap
       précompilé (CDN) plutôt qu'en variables Sass — pas d'étape de build ici. #}
    <style>
        body {
            background-color: #f5f7fb;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        .germ-sidebar {
            min-height: 100vh;
            width: 252px;
            background: #1a2332;
            color: #7b8fa3;
        }
        .germ-sidebar .brand {
            color: #fff;
            font-weight: 600;
            letter-spacing: .5px;
        }
        .germ-sidebar .brand .brand-logo {
            height: 36px;
            width: auto;
            filter: brightness(0) invert(1);
        }
        .germ-sidebar a {
            color: #7b8fa3;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .375rem .75rem;
            border-radius: .25rem;
            margin: 0 .5rem 1px;
            font-size: .8125rem;
        }
        .germ-sidebar a:hover {
            background: rgba(255, 255, 255, .04);
            color: #c5d0dc;
        }
        .germ-sidebar a.active {
            background: rgba(26, 187, 156, .08);
            color: #fff;
            box-shadow: inset 2px 0 0 #1abb9c;
        }
        .germ-sidebar .submenu-toggle {
            cursor: pointer;
            justify-content: space-between;
        }
        .germ-sidebar .submenu-toggle .bi-chevron-down {
            transition: transform .15s ease-in-out;
            font-size: .7rem;
            margin-left: auto;
        }
        .germ-sidebar .submenu-toggle[aria-expanded="true"] .bi-chevron-down {
            transform: rotate(180deg);
        }
        .germ-sidebar .submenu a {
            padding-left: 2.35rem;
            font-size: .78125rem;
        }
        .germ-sidebar .submenu .submenu a {
            padding-left: 3.7rem;
            font-size: .75rem;
        }
        .germ-topbar {
            background: #fff;
            border-bottom: 1px solid #e6e7eb;
        }
        .germ-main { flex: 1; min-width: 0; }
        .stat-card { border: none; border-radius: .5rem; box-shadow: 0 2px 4px 0 rgba(30, 38, 51, .04); }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% if app.user %}
    <div class="d-flex">
        <nav class="germ-sidebar d-flex flex-column py-3">
            <div class="brand px-3 pb-3 d-flex align-items-center gap-2">
                <img src="{{ asset('images/logo-mini.png') }}" alt="MinCom" class="brand-logo">
                <div>
                    <div class="fs-5">GERM</div>
                    <div class="small fw-normal text-white-50">Ministère de l'Industrie et du Commerce</div>
                </div>
            </div>
            {% set route = app.request.attributes.get('_route') %}
            {% set categorie_actuelle = app.request.attributes.get('categorie') %}
            {% set personnel_active = 'admin_personnel' in route or 'admin_carriere' in route or categorie_actuelle in ['type-contrat', 'type-document'] %}
            {% set conge_active = 'admin_conge' in route or 'admin_decision_conge' in route or 'admin_demande_decision' in route or 'admin_demande_jouissance' in route %}
            {% set carte_active = 'admin_carte_professionnelle' in route or 'admin_demande_carte_pro' in route %}
            {% set delegation_active = 'admin_delegation' in route %}
            {% set rh_active = personnel_active or conge_active or carte_active or delegation_active %}
            {% set informatique_active = 'admin_materiel' in route or categorie_actuelle in ['type-materiel', 'etat-materiel', 'priorite-ticket', 'type-maintenance', 'logiciel-os', 'logiciel-antivirus', 'logiciel-bureautique'] %}
            {% set vehicule_active = 'admin_vehicule' in route or categorie_actuelle in ['type-vehicule', 'etat-vehicule'] %}
            {% set import_active = 'admin_import' in route %}

            {% if is_granted('ROLE_SUPERADMIN') %}
                {# Tous les modules RH sont désormais réservés à Angular ; Twig ne reste
                   accessible qu'au superadmin, en secours — un seul garde englobant plutôt
                   qu'un OR par item (l'ancien découpage RH_PERSONNEL/RH_CONGE/RH_RESPONSABLE n'a
                   plus de sens ici, la hiérarchie de rôles accorde tout au superadmin). #}
                <div class="text-uppercase small text-white-50 px-3 pb-1">Tableaux de bord</div>
                <a href="{{ path('admin_dashboard_personnel') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard_personnel' ? 'active' }}">
                    <i class="bi bi-speedometer2"></i> Personnel
                </a>
                <a href="{{ path('admin_dashboard_materiel') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard_materiel' ? 'active' }}">
                    <i class="bi bi-speedometer2"></i> Informatique
                </a>
                <a href="{{ path('admin_dashboard_vehicule') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard_vehicule' ? 'active' }}">
                    <i class="bi bi-speedometer2"></i> Parc automobile
                </a>

                <div class="text-uppercase small text-white-50 px-3 pt-3 pb-1">Ressources</div>

                <a href="#submenuRH" class="submenu-toggle {{ rh_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ rh_active ? 'true' : 'false' }}" aria-controls="submenuRH">
                    <span><i class="bi bi-diagram-3"></i> Ressources Humaines</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse submenu {{ rh_active ? 'show' }}" id="submenuRH">
                    <a href="#submenuPersonnel" class="submenu-toggle {{ personnel_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ personnel_active ? 'true' : 'false' }}" aria-controls="submenuPersonnel">
                        <span><i class="bi bi-people"></i> Personnel</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse submenu {{ personnel_active ? 'show' }}" id="submenuPersonnel">
                        <a href="{{ path('admin_personnel_index') }}" class="{{ 'admin_personnel' in route ? 'active' }}">Personnel</a>
                        <a href="{{ path('admin_carriere_index') }}" class="{{ 'admin_carriere' in route ? 'active' }}">Gestion des carrières</a>
                        <a href="{{ path('admin_liste_valeur_index', {categorie: 'type-contrat'}) }}" class="{{ categorie_actuelle == 'type-contrat' ? 'active' }}">Types de contrat</a>
                        <a href="{{ path('admin_liste_valeur_index', {categorie: 'type-document'}) }}" class="{{ categorie_actuelle == 'type-document' ? 'active' }}">Types de document</a>
                    </div>

                    <a href="#submenuConge" class="submenu-toggle {{ conge_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ conge_active ? 'true' : 'false' }}" aria-controls="submenuConge">
                        <span><i class="bi bi-calendar-event"></i> Congés</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse submenu {{ conge_active ? 'show' }}" id="submenuConge">
                        <a href="{{ path('admin_conge_index') }}" class="{{ 'admin_conge' in route ? 'active' }}">Gestion des congés</a>
                        <a href="{{ path('admin_decision_conge_index') }}" class="{{ 'admin_decision_conge' in route ? 'active' }}">Décisions de congé</a>
                        <a href="{{ path('admin_demande_decision_index') }}" class="{{ 'admin_demande_decision' in route ? 'active' }}">Demandes de décision</a>
                        <a href="{{ path('admin_demande_jouissance_index') }}" class="{{ 'admin_demande_jouissance' in route ? 'active' }}">Demandes de jouissance</a>
                    </div>

                    <a href="#submenuCartePro" class="submenu-toggle {{ carte_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ carte_active ? 'true' : 'false' }}" aria-controls="submenuCartePro">
                        <span><i class="bi bi-person-vcard"></i> Cartes professionnelles</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse submenu {{ carte_active ? 'show' }}" id="submenuCartePro">
                        <a href="{{ path('admin_carte_professionnelle_index') }}" class="{{ route == 'admin_carte_professionnelle_index' ? 'active' }}">Cartes professionnelles</a>
                        <a href="{{ path('admin_demande_carte_pro_index') }}" class="{{ 'admin_demande_carte_pro' in route ? 'active' }}">Demandes de carte professionnelle</a>
                        <a href="{{ path('admin_carte_professionnelle_validation') }}" class="{{ route == 'admin_carte_professionnelle_validation' ? 'active' }}">Validation des cartes</a>
                    </div>

                    <a href="{{ path('admin_delegation_index') }}" class="{{ delegation_active ? 'active' }}">Délégations</a>
                </div>

                <a href="#submenuInformatique" class="submenu-toggle {{ informatique_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ informatique_active ? 'true' : 'false' }}" aria-controls="submenuInformatique">
                    <span><i class="bi bi-pc-display"></i> Informatique</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse submenu {{ informatique_active ? 'show' }}" id="submenuInformatique">
                    <a href="{{ path('admin_materiel_index') }}" class="{{ 'admin_materiel' in route ? 'active' }}">Parc informatique</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'type-materiel'}) }}" class="{{ categorie_actuelle == 'type-materiel' ? 'active' }}">Types de matériel</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'etat-materiel'}) }}" class="{{ categorie_actuelle == 'etat-materiel' ? 'active' }}">États du matériel</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'niveau-vulnerabilite'}) }}" class="{{ categorie_actuelle == 'niveau-vulnerabilite' ? 'active' }}">Niveaux de vulnérabilité</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'priorite-ticket'}) }}" class="{{ categorie_actuelle == 'priorite-ticket' ? 'active' }}">Priorités de ticket</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'type-maintenance'}) }}" class="{{ categorie_actuelle == 'type-maintenance' ? 'active' }}">Types de maintenance</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'logiciel-os'}) }}" class="{{ categorie_actuelle == 'logiciel-os' ? 'active' }}">Systèmes d'exploitation</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'logiciel-antivirus'}) }}" class="{{ categorie_actuelle == 'logiciel-antivirus' ? 'active' }}">Antivirus</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'logiciel-bureautique'}) }}" class="{{ categorie_actuelle == 'logiciel-bureautique' ? 'active' }}">Suites bureautiques</a>
                </div>

                <a href="#submenuVehicule" class="submenu-toggle {{ vehicule_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ vehicule_active ? 'true' : 'false' }}" aria-controls="submenuVehicule">
                    <span><i class="bi bi-truck"></i> Parc automobile</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse submenu {{ vehicule_active ? 'show' }}" id="submenuVehicule">
                    <a href="{{ path('admin_vehicule_index') }}" class="{{ 'admin_vehicule' in route ? 'active' }}">Parc automobile</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'type-vehicule'}) }}" class="{{ categorie_actuelle == 'type-vehicule' ? 'active' }}">Types de véhicule</a>
                    <a href="{{ path('admin_liste_valeur_index', {categorie: 'etat-vehicule'}) }}" class="{{ categorie_actuelle == 'etat-vehicule' ? 'active' }}">États des véhicules</a>
                </div>
            {% endif %}

            {% if is_granted('ROLE_SUPERADMIN') %}
                <div class="text-uppercase small text-white-50 px-3 pt-3 pb-1">Administration</div>
                <a href="{{ path('admin_direction_index') }}" class="{{ 'admin_direction' in route ? 'active' }}">
                    <i class="bi bi-building"></i> Directions
                </a>
                <a href="{{ path('admin_service_index') }}" class="{{ 'admin_service' in route ? 'active' }}">
                    <i class="bi bi-diagram-3"></i> Services
                </a>
                <a href="{{ path('admin_agent_index') }}" class="{{ 'admin_agent' in route ? 'active' }}">
                    <i class="bi bi-person-badge"></i> Comptes agents
                </a>

                <a href="#submenuImport" class="submenu-toggle {{ import_active ? 'active' }}" data-bs-toggle="collapse" role="button" aria-expanded="{{ import_active ? 'true' : 'false' }}" aria-controls="submenuImport">
                    <span><i class="bi bi-file-earmark-excel"></i> Import de données</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse submenu {{ import_active ? 'show' }}" id="submenuImport">
                    <a href="{{ path('admin_import_upload', {type: 'direction'}) }}" class="{{ app.request.pathinfo == path('admin_import_upload', {type: 'direction'}) ? 'active' }}">Directions</a>
                    <a href="{{ path('admin_import_upload', {type: 'service'}) }}" class="{{ app.request.pathinfo == path('admin_import_upload', {type: 'service'}) ? 'active' }}">Services</a>
                    <a href="{{ path('admin_import_upload', {type: 'personnel'}) }}" class="{{ app.request.pathinfo == path('admin_import_upload', {type: 'personnel'}) ? 'active' }}">Personnel</a>
                    <a href="{{ path('admin_import_upload', {type: 'materiel'}) }}" class="{{ app.request.pathinfo == path('admin_import_upload', {type: 'materiel'}) ? 'active' }}">Parc informatique</a>
                    <a href="{{ path('admin_import_upload', {type: 'vehicule'}) }}" class="{{ app.request.pathinfo == path('admin_import_upload', {type: 'vehicule'}) ? 'active' }}">Parc automobile</a>
                </div>
            {% endif %}
        </nav>
        <div class="germ-main d-flex flex-column">
            <header class="germ-topbar d-flex justify-content-between align-items-center px-4 py-2">
                <div class="fw-semibold">{% block page_title %}Superadmin{% endblock %}</div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">{{ app.user.nom }} {{ app.user.prenom }}</span>
                    <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-right"></i> Déconnexion
                    </a>
                </div>
            </header>
            <main class="p-4">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : label) }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
{% else %}
    {% block full_body %}{% endblock %}
{% endif %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
