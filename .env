# Copiez ce fichier en .env.local pour vos valeurs réelles (ne pas committer .env.local)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_random_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://germ_user:germ_password@127.0.0.1:3306/germ_db?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
