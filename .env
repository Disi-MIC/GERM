# Copiez ce fichier en .env.local pour vos valeurs réelles (ne pas committer .env.local)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_random_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://germ_user:germ_password@127.0.0.1:3306/germ_db?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# capacitor://localhost : origine de la WebView de l'app native iOS (Android
# utilise déjà http://localhost, couvert par le premier groupe) — voir
# frontend/capacitor.config.ts. À réévaluer pour la prod : une fois l'app
# distribuée, son origine restera capacitor://localhost même si elle
# pointe vers un vrai domaine HTTPS (voir environment.mobile.ts).
CORS_ALLOW_ORIGIN='^(https?://(localhost|127\.0\.0\.1)(:[0-9]+)?|capacitor://localhost)$'
###< nelmio/cors-bundle ###

###> frontend (Angular) ###
# URL du frontend Angular : les rôles RH (tout sauf ROLE_SUPERADMIN) y sont
# redirigés directement après connexion via /login, Twig n'étant plus qu'un
# accès de secours pour le superadmin. À surcharger en production dans
# .env.local (ex: https://app.germ.mincom.sn).
FRONTEND_URL=http://localhost:4200
###< frontend (Angular) ###

###> parc informatique (QR code) ###
# Clé secrète (32 octets, base64) chiffrant le contenu des étiquettes QR
# matériel (voir QrTokenService) — jamais l'identifiant en clair dans le QR,
# pour qu'un scan hors de l'app (appareil photo classique) ne révèle qu'un
# jeton illisible. Valeur de dev uniquement : à régénérer en production dans
# .env.local (ex: `php -r "echo base64_encode(random_bytes(32));"`), jamais
# la même clé qu'en dev.
QR_SECRET_KEY=5TT3qdofIzJ29oTjpz9VVdhrPx3q1EBJ838obzPzZlY=
###< parc informatique (QR code) ###

###> sftp storage ###
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_ROOT=
# true uniquement en dev délocalisé (.env.local, non versionné) : le SFTP
# ci-dessus n'est joignable que depuis le réseau interne du ministère — voir
# FileStorage. Ne jamais mettre à true ici (valeur commitée = celle de la prod).
FILE_STORAGE_LOCAL=false
###< sftp storage ###
